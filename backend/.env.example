PORT=5000
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require
JWT_SECRET=replace_with_a_strong_secret

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

GROQ_API_KEY=your_groq_api_key

# Choose one: smtp or resend
EMAIL_PROVIDER=smtp
EMAIL_FROM=PulseCare <your_sender@example.com>

# SMTP settings (required when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_sender@gmail.com
SMTP_PASS=your_app_password

# Resend settings (required when EMAIL_PROVIDER=resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

FRONTEND_URL=http://localhost:3000

RAPIDAPI_KEY=your_rapidapi_key
RAPIDAPI_HOST=endlessmedicalapi1.p.rapidapi.com
DEEPSEEK_API=your_deepseek_key

AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
JITSI_APP_KEY=vpaas-magic-cookie-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Scheduling timezone offset in minutes from UTC.
# Example: India Standard Time (IST) = 330.
SCHEDULING_UTC_OFFSET_MINUTES=330